{
  "info": {
    "name": "Staff Booking Overhaul",
    "description": "Covers the new/changed API surface from this batch: GET/PATCH /branches (Superadmin System Configuration), GET /bookings/availability now returning a `window` alongside `slots`, POST /staff/:id/unavailability with the new Entire Day (is_full_day/date) option, and POST /bookings accepting hotel_preferences.feeding[]/medications[] catalog fields (food_catalog_id/medication_catalog_id/brought_by_customer). Run items 1-3 first (logins), then the rest in any order within their own numbered group. Fill in the collection variables before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "superadmin_identifier", "value": "" },
    { "key": "superadmin_password", "value": "" },
    { "key": "admin_identifier", "value": "" },
    { "key": "admin_password", "value": "" },
    { "key": "staff_identifier", "value": "" },
    { "key": "staff_password", "value": "" },
    { "key": "customer_id", "value": "" },
    { "key": "pet_id", "value": "" },
    { "key": "branch_id", "value": "" },
    { "key": "hotel_service_id", "value": "" },
    { "key": "food_catalog_id", "value": "" },
    { "key": "medication_catalog_id", "value": "" },
    { "key": "target_staff_id", "value": "" },
    { "key": "superadmin_access_token", "value": "" },
    { "key": "admin_access_token", "value": "" },
    { "key": "staff_access_token", "value": "" }
  ],
  "item": [
    {
      "name": "1. Login as Superadmin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{superadmin_identifier}}\",\n  \"password\": \"{{superadmin_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/staff/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "staff", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login returns 200 with an access token', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().access_token).to.be.a('string');",
              "});",
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('superadmin_access_token', pm.response.json().access_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Login as Admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{admin_identifier}}\",\n  \"password\": \"{{admin_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/staff/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "staff", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login returns 200 with an access token', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('admin_access_token', pm.response.json().access_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Login as Staff (Receptionist)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{staff_identifier}}\",\n  \"password\": \"{{staff_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/staff/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "staff", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login returns 200 with an access token', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('staff_access_token', pm.response.json().access_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Superadmin System Configuration",
      "item": [
        {
          "name": "4a. GET /branches as Superadmin - full rows",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{superadmin_access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/branches",
              "host": ["{{base_url}}"],
              "path": ["branches"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200, returns branches with operating_hours', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.branches).to.be.an('array');",
                  "  pm.expect(body.branches[0]).to.have.property('operating_hours');",
                  "  pm.expect(body.branches[0]).to.have.property('address');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4b. GET /branches as Admin - 403 (Superadmin-only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/branches",
              "host": ["{{base_url}}"],
              "path": ["branches"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden - deliberately narrower than ADMIN_ROLES', function () {",
                  "  pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4c. PATCH /branches/:id - update operating hours",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "Authorization",
                "value": "Bearer {{superadmin_access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operating_hours\": {\n    \"monday\": { \"open\": \"08:00\", \"close\": \"19:00\" }\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/branches/{{branch_id}}",
              "host": ["{{base_url}}"],
              "path": ["branches", "{{branch_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200, monday close updated to 19:00', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().branch.operating_hours.monday.close).to.eql('19:00');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4d. PATCH /branches/:id - rejects a close time not after open",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "Authorization",
                "value": "Bearer {{superadmin_access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operating_hours\": {\n    \"monday\": { \"open\": \"18:00\", \"close\": \"08:00\" }\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/branches/{{branch_id}}",
              "host": ["{{base_url}}"],
              "path": ["branches", "{{branch_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Invalid payload', function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Merged Date/Time + Staff step",
      "item": [
        {
          "name": "5a. GET /bookings/availability - response now includes `window`",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('availability_date', new Date().toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200, response has both slots[] and window', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('slots');",
                  "  pm.expect(body).to.have.property('window');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{staff_access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/bookings/availability?branch_id={{branch_id}}&service_category=Grooming&date={{availability_date}}&slot_duration_minutes=60",
              "host": ["{{base_url}}"],
              "path": ["bookings", "availability"],
              "query": [
                { "key": "branch_id", "value": "{{branch_id}}" },
                { "key": "service_category", "value": "Grooming" },
                { "key": "date", "value": "{{availability_date}}" },
                { "key": "slot_duration_minutes", "value": "60" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "6. Days off (Entire Day option)",
      "item": [
        {
          "name": "6a. POST /staff/:id/unavailability - Entire Day for another staff member (auto-approved)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000);",
                  "pm.collectionVariables.set('full_day_date', d.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201, is_full_day true, status approved (on-behalf-of)', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const block = pm.response.json().block;",
                  "  pm.expect(block.is_full_day).to.eql(true);",
                  "  pm.expect(block.status).to.eql('approved');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_full_day\": true,\n  \"date\": \"{{full_day_date}}\",\n  \"reason\": \"Approved leave\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/staff/{{target_staff_id}}/unavailability",
              "host": ["{{base_url}}"],
              "path": ["staff", "{{target_staff_id}}", "unavailability"]
            }
          }
        },
        {
          "name": "6b. POST /staff/:id/unavailability - Entire Day requires date",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "Authorization",
                "value": "Bearer {{staff_access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_full_day\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/staff/{{target_staff_id}}/unavailability",
              "host": ["{{base_url}}"],
              "path": ["staff", "{{target_staff_id}}", "unavailability"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 - date is required for a full-day request', function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "7. Care Instructions catalog wiring",
      "item": [
        {
          "name": "7a. POST /bookings - Hotel booking with catalog-linked feeding/medications",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const start = new Date(Date.now() + 24 * 60 * 60 * 1000);",
                  "const end = new Date(start.getTime() + 24 * 60 * 60 * 1000);",
                  "pm.collectionVariables.set('hotel_start', start.toISOString());",
                  "pm.collectionVariables.set('hotel_end', end.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201, hotel_preferences round-trips the catalog fields', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const booking = pm.response.json().booking;",
                  "  const feeding = booking.hotel_preferences.feeding[0];",
                  "  pm.expect(feeding.food_catalog_id).to.eql(pm.collectionVariables.get('food_catalog_id'));",
                  "  pm.expect(feeding.brought_by_customer).to.eql(false);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('hotel_booking_id', pm.response.json().booking.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "Authorization",
                "value": "Bearer {{staff_access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": \"{{customer_id}}\",\n  \"pet_id\": \"{{pet_id}}\",\n  \"branch_id\": \"{{branch_id}}\",\n  \"service_category\": \"Hotel\",\n  \"service_id\": \"{{hotel_service_id}}\",\n  \"scheduled_start\": \"{{hotel_start}}\",\n  \"scheduled_end\": \"{{hotel_end}}\",\n  \"hotel_preferences\": {\n    \"feeding\": [\n      {\n        \"meal_time\": \"Morning\",\n        \"food_type\": \"Premium Kibble\",\n        \"quantity\": \"2\",\n        \"food_catalog_id\": \"{{food_catalog_id}}\",\n        \"brought_by_customer\": false\n      }\n    ],\n    \"walking\": [],\n    \"medications\": [\n      {\n        \"medication_name\": \"Amoxicillin\",\n        \"dose\": \"250mg\",\n        \"scheduled_times\": [\"08:00\"],\n        \"medication_catalog_id\": \"{{medication_catalog_id}}\",\n        \"brought_by_customer\": false\n      }\n    ]\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/bookings",
              "host": ["{{base_url}}"],
              "path": ["bookings"]
            }
          }
        },
        {
          "name": "7b. POST /bookings - hotel_preferences rejected on a non-Hotel booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "Authorization",
                "value": "Bearer {{staff_access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": \"{{customer_id}}\",\n  \"pet_id\": \"{{pet_id}}\",\n  \"branch_id\": \"{{branch_id}}\",\n  \"service_category\": \"Grooming\",\n  \"service_id\": \"{{hotel_service_id}}\",\n  \"scheduled_start\": \"{{hotel_start}}\",\n  \"scheduled_end\": \"{{hotel_end}}\",\n  \"hotel_preferences\": { \"feeding\": [], \"walking\": [], \"medications\": [] }\n}"
            },
            "url": {
              "raw": "{{base_url}}/bookings",
              "host": ["{{base_url}}"],
              "path": ["bookings"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Invalid query/payload', function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "8. Bookings queue search/sort (no server change - client-side only)",
      "item": [
        {
          "name": "8a. GET /bookings?status=Pending - confirm the status filter itself is not broken",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{staff_access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/bookings?status=Pending",
              "host": ["{{base_url}}"],
              "path": ["bookings"],
              "query": [{ "key": "status", "value": "Pending" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200, every returned booking has status Pending', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const bookings = pm.response.json().bookings;",
                  "  bookings.forEach((b) => pm.expect(b.status).to.eql('Pending'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
