{
  "info": {
    "name": "Booking Status Automation",
    "description": "Run items 3-13 in order (top-to-bottom). Requires a real customer with a real pet and a real staff login - fill in the collection variables first. Run during the target branch's normal operating hours: items 3 and 7 book a Grooming slot ~1 hour in the past / ~24 hours ahead respectively, and Grooming capacity is staff-availability-gated by the branch's operating_hours - running this well outside business hours can make the Grooming booking legitimately fail capacity with an unrelated 409, not the behavior under test.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "staff_identifier", "value": "" },
    { "key": "staff_password", "value": "" },
    { "key": "customer_email", "value": "" },
    { "key": "customer_password", "value": "" },
    { "key": "branch_id", "value": "" },
    { "key": "pet_id", "value": "" },
    { "key": "grooming_service_id", "value": "" },
    { "key": "staff_access_token", "value": "" },
    { "key": "customer_access_token", "value": "" },
    { "key": "past_booking_id", "value": "" },
    { "key": "future_booking_id", "value": "" }
  ],
  "item": [
    {
      "name": "1. Login as Staff",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{staff_identifier}}\",\n  \"password\": \"{{staff_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/staff/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "staff", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login returns 200 with an access token', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().access_token).to.be.a('string');",
              "});",
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('staff_access_token', pm.response.json().access_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Login as Customer",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"account_email\": \"{{customer_email}}\",\n  \"password\": \"{{customer_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/customers/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "customers", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login returns 200 with an access token', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().access_token).to.be.a('string');",
              "});",
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('customer_access_token', pm.response.json().access_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Create a booking whose time has already passed (for the No-show test)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const start = new Date(Date.now() - 60 * 60 * 1000);",
              "const end = new Date(Date.now() - 30 * 60 * 1000);",
              "pm.collectionVariables.set('past_start', start.toISOString());",
              "pm.collectionVariables.set('past_end', end.toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created, status is Pending at creation time', function () {",
              "  pm.response.to.have.status(201);",
              "  pm.expect(pm.response.json().booking.status).to.eql('Pending');",
              "});",
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('past_booking_id', pm.response.json().booking.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          {
            "key": "Authorization",
            "value": "Bearer {{customer_access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pet_id\": \"{{pet_id}}\",\n  \"branch_id\": \"{{branch_id}}\",\n  \"service_category\": \"Grooming\",\n  \"service_id\": \"{{grooming_service_id}}\",\n  \"scheduled_start\": \"{{past_start}}\",\n  \"scheduled_end\": \"{{past_end}}\",\n  \"payment_method\": \"Cash\",\n  \"payment_confirmed\": false\n}"
        },
        "url": {
          "raw": "{{base_url}}/bookings",
          "host": ["{{base_url}}"],
          "path": ["bookings"]
        }
      }
    },
    {
      "name": "4. Reading it back auto-flips it to No-show (lazy transition, no cron)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customer_access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/bookings/{{past_booking_id}}",
          "host": ["{{base_url}}"],
          "path": ["bookings", "{{past_booking_id}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is now No-show, even though it was Pending a moment ago', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().booking.status).to.eql('No-show');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. A No-show booking can no longer be Started",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{staff_access_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/bookings/{{past_booking_id}}/start",
          "host": ["{{base_url}}"],
          "path": ["bookings", "{{past_booking_id}}", "start"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('rejected 409 - a No-show booking cannot be started', function () {",
              "  pm.response.to.have.status(409);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. A No-show booking can no longer be rescheduled",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{staff_access_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"scheduled_start\": \"2027-01-01T01:00:00+00:00\",\n  \"scheduled_end\": \"2027-01-01T02:00:00+00:00\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/bookings/{{past_booking_id}}/reschedule",
          "host": ["{{base_url}}"],
          "path": ["bookings", "{{past_booking_id}}", "reschedule"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('rejected 409 - only Pending bookings are reschedulable', function () {",
              "  pm.response.to.have.status(409);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Create a future booking for the full Start -> Complete -> Paid walkthrough",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const start = new Date(Date.now() + 24 * 60 * 60 * 1000);",
              "const end = new Date(start.getTime() + 60 * 60 * 1000);",
              "pm.collectionVariables.set('future_start', start.toISOString());",
              "pm.collectionVariables.set('future_end', end.toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created, status is Pending', function () {",
              "  pm.response.to.have.status(201);",
              "  pm.expect(pm.response.json().booking.status).to.eql('Pending');",
              "});",
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('future_booking_id', pm.response.json().booking.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          {
            "key": "Authorization",
            "value": "Bearer {{customer_access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pet_id\": \"{{pet_id}}\",\n  \"branch_id\": \"{{branch_id}}\",\n  \"service_category\": \"Grooming\",\n  \"service_id\": \"{{grooming_service_id}}\",\n  \"scheduled_start\": \"{{future_start}}\",\n  \"scheduled_end\": \"{{future_end}}\",\n  \"payment_method\": \"Cash\",\n  \"payment_confirmed\": false\n}"
        },
        "url": {
          "raw": "{{base_url}}/bookings",
          "host": ["{{base_url}}"],
          "path": ["bookings"]
        }
      }
    },
    {
      "name": "8. Start it",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{staff_access_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/bookings/{{future_booking_id}}/start",
          "host": ["{{base_url}}"],
          "path": ["bookings", "{{future_booking_id}}", "start"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK, status is In Progress, started_at is set', function () {",
              "  pm.response.to.have.status(200);",
              "  const booking = pm.response.json().booking;",
              "  pm.expect(booking.status).to.eql('In Progress');",
              "  pm.expect(booking.started_at).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Starting it again is rejected (already In Progress)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{staff_access_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/bookings/{{future_booking_id}}/start",
          "host": ["{{base_url}}"],
          "path": ["bookings", "{{future_booking_id}}", "start"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('rejected 409', function () { pm.response.to.have.status(409); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Complete it (Cash booking - stops at Completed, not auto-Paid)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{staff_access_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/bookings/{{future_booking_id}}/complete",
          "host": ["{{base_url}}"],
          "path": ["bookings", "{{future_booking_id}}", "complete"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK, status is Completed (not Paid - Cash needs a manual Mark as Paid)', function () {",
              "  pm.response.to.have.status(200);",
              "  const booking = pm.response.json().booking;",
              "  pm.expect(booking.status).to.eql('Completed');",
              "  pm.expect(booking.completed_at).to.be.a('string');",
              "  pm.expect(booking.paid_at).to.be.null;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Mark it Paid",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{staff_access_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/bookings/{{future_booking_id}}/mark-paid",
          "host": ["{{base_url}}"],
          "path": ["bookings", "{{future_booking_id}}", "mark-paid"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK, status is Paid, paid_at is set', function () {",
              "  pm.response.to.have.status(200);",
              "  const booking = pm.response.json().booking;",
              "  pm.expect(booking.status).to.eql('Paid');",
              "  pm.expect(booking.paid_at).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Marking it Paid again is rejected (already Paid)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{staff_access_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/bookings/{{future_booking_id}}/mark-paid",
          "host": ["{{base_url}}"],
          "path": ["bookings", "{{future_booking_id}}", "mark-paid"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('rejected 409', function () { pm.response.to.have.status(409); });"
            ]
          }
        }
      ]
    },
    {
      "name": "13. A Paid booking can no longer be cancelled",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{staff_access_token}}" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": {
          "raw": "{{base_url}}/bookings/{{future_booking_id}}/cancel",
          "host": ["{{base_url}}"],
          "path": ["bookings", "{{future_booking_id}}", "cancel"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('rejected 409 - only Pending/In Progress bookings are cancellable', function () {",
              "  pm.response.to.have.status(409);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
