{
  "info": {
    "name": "Issue 64 - Grooming Status-Transition Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "groomer1_email", "value": "" },
    { "key": "groomer1_password", "value": "" },
    { "key": "groomer2_email", "value": "" },
    { "key": "groomer2_password", "value": "" },
    { "key": "admin_email", "value": "" },
    { "key": "admin_password", "value": "" },
    { "key": "groomer1_token", "value": "" },
    { "key": "groomer2_token", "value": "" },
    { "key": "admin_token", "value": "" },
    { "key": "grooming_booking_id", "value": "" },
    { "key": "session_id", "value": "" }
  ],
  "item": [
    {
      "name": "1. Login Groomer 1",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{groomer1_email}}\",\n  \"password\": \"{{groomer1_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/staff/login",
          "host": ["{{base_url}}"],
          "path": ["staff", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Groomer 1 login returns 200 with an access token', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().access_token).to.be.a('string');",
              "});",
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('groomer1_token', pm.response.json().access_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Login Groomer 2",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{groomer2_email}}\",\n  \"password\": \"{{groomer2_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/staff/login",
          "host": ["{{base_url}}"],
          "path": ["staff", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Groomer 2 login returns 200 with an access token', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().access_token).to.be.a('string');",
              "});",
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('groomer2_token', pm.response.json().access_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Login Admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/staff/login",
          "host": ["{{base_url}}"],
          "path": ["staff", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin login returns 200 with an access token', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().access_token).to.be.a('string');",
              "});",
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('admin_token', pm.response.json().access_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "4. GET queue (Groomer 1) - auto-creates Waiting session",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{groomer1_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/grooming/queue",
          "host": ["{{base_url}}"],
          "path": ["grooming", "queue"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200, session for the booking exists with status Waiting', function () {",
              "  pm.response.to.have.status(200);",
              "  const sessions = pm.response.json().sessions;",
              "  pm.expect(sessions).to.be.an('array');",
              "  const match = sessions.find(s => s.booking_id === pm.collectionVariables.get('grooming_booking_id'));",
              "  pm.expect(match).to.not.be.undefined;",
              "  pm.expect(match.status).to.eql('Waiting');",
              "  pm.collectionVariables.set('session_id', match.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. AC-1 PATCH -> In Progress (Groomer 1)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{groomer1_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"In Progress\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/grooming/sessions/{{session_id}}/status",
          "host": ["{{base_url}}"],
          "path": ["grooming", "sessions", "{{session_id}}", "status"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200, status In Progress with started_at set', function () {",
              "  pm.response.to.have.status(200);",
              "  const session = pm.response.json().session;",
              "  pm.expect(session.status).to.eql('In Progress');",
              "  pm.expect(session.started_at).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. AC-3 PATCH -> Completed (Groomer 2, wrong groomer)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{groomer2_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Completed\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/grooming/sessions/{{session_id}}/status",
          "host": ["{{base_url}}"],
          "path": ["grooming", "sessions", "{{session_id}}", "status"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('403 Forbidden for a different groomer', function () {",
              "  pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "7. AC-1/AC-2 PATCH -> Completed (Groomer 1)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{groomer1_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Completed\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/grooming/sessions/{{session_id}}/status",
          "host": ["{{base_url}}"],
          "path": ["grooming", "sessions", "{{session_id}}", "status"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200, status Completed with completed_at set', function () {",
              "  pm.response.to.have.status(200);",
              "  const session = pm.response.json().session;",
              "  pm.expect(session.status).to.eql('Completed');",
              "  pm.expect(session.completed_at).to.be.a('string');",
              "});",
              "pm.test('Reminder: verify bookings.status = Completed in Supabase Studio', function () {",
              "  pm.expect(true).to.be.true;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "8. AC-4 PATCH -> Completed again (already finalized)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{groomer1_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Completed\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/grooming/sessions/{{session_id}}/status",
          "host": ["{{base_url}}"],
          "path": ["grooming", "sessions", "{{session_id}}", "status"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 already finalized', function () {",
              "  pm.response.to.have.status(409);",
              "  pm.expect(pm.response.json().error).to.match(/already finalized/i);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
