{
  "info": {
    "name": "Issue 31 - Customer Profile CRUD Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "customer_email", "value": "" },
    { "key": "customer_password", "value": "" },
    { "key": "customer_id", "value": "" },
    { "key": "other_customer_id", "value": "" },
    { "key": "staff_identifier", "value": "" },
    { "key": "staff_password", "value": "" },
    { "key": "customer_access_token", "value": "" },
    { "key": "staff_access_token", "value": "" }
  ],
  "item": [
    {
      "name": "1. Login as customer",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"account_email\": \"{{customer_email}}\",\n  \"password\": \"{{customer_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/customers/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "customers", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('customer login returns 200 with an access token', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('customer_access_token', pm.response.json().access_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Login as staff (Receptionist)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{staff_identifier}}\",\n  \"password\": \"{{staff_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/staff/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "staff", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('staff login returns 200 with an access token', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('staff_access_token', pm.response.json().access_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "3. AC-1: Customer GETs their own profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customer_access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/customers/{{customer_id}}",
          "host": ["{{base_url}}"],
          "path": ["customers", "{{customer_id}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('AC-1: returns 200 with the own profile', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().customer.id).to.eql(pm.collectionVariables.get('customer_id'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. AC-2: Customer GETs a different customer's profile (403)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customer_access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/customers/{{other_customer_id}}",
          "host": ["{{base_url}}"],
          "path": ["customers", "{{other_customer_id}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('AC-2: returns 403 for a non-staff caller viewing another customer', function () {",
              "  pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. AC-2: Staff GETs the customer's profile",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{staff_access_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/customers/{{customer_id}}",
          "host": ["{{base_url}}"],
          "path": ["customers", "{{customer_id}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('AC-2: an authorized staff role can view any customer', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. AC-3: Staff lists all customers",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{staff_access_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/customers",
          "host": ["{{base_url}}"],
          "path": ["customers"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('AC-3: authorized staff can list customers', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().customers).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "7. AC-3: Customer attempts to list all customers (403)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customer_access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/customers",
          "host": ["{{base_url}}"],
          "path": ["customers"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('AC-3: a customer cannot list all customers', function () {",
              "  pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "8. AC-4: Customer PATCHes their own profile",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          {
            "key": "Authorization",
            "value": "Bearer {{customer_access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"contact_number\": \"09171234567\",\n  \"preferred_communication_channel\": \"Viber\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/customers/{{customer_id}}",
          "host": ["{{base_url}}"],
          "path": ["customers", "{{customer_id}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('AC-4: updates and persists the change', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().customer.contact_number).to.eql('09171234567');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "9. AC-5: Customer PATCHes with an account_email field (400)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          {
            "key": "Authorization",
            "value": "Bearer {{customer_access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"account_email\": \"someone-else@example.com\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/customers/{{customer_id}}",
          "host": ["{{base_url}}"],
          "path": ["customers", "{{customer_id}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('AC-5: account_email is rejected with 400', function () {",
              "  pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "10. AC-6: Staff PATCHes on the customer's behalf",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{staff_access_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"emergency_contact_name\": \"Recorded by reception\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/customers/{{customer_id}}",
          "host": ["{{base_url}}"],
          "path": ["customers", "{{customer_id}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('AC-6: an authorized staff role can update on behalf of the customer', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().customer.emergency_contact_name).to.eql('Recorded by reception');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
