{
  "info": {
    "name": "Issue 53 - Makati-only Veterinary Enforcement",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "customer_account_email", "value": "" },
    { "key": "customer_password", "value": "" },
    { "key": "customer_access_token", "value": "" },
    { "key": "pet_id", "value": "" },
    { "key": "branch_makati_id", "value": "" },
    { "key": "branch_southwoods_id", "value": "" },
    { "key": "vet_service_id", "value": "" },
    { "key": "daycare_service_id", "value": "" },
    { "key": "vet_booking_id", "value": "" },
    { "key": "slot_start", "value": "" },
    { "key": "slot_end", "value": "" },
    { "key": "slot2_start", "value": "" },
    { "key": "slot2_end", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('slot_start')) {",
          "  const now = new Date();",
          "  const diff = (((8 - now.getUTCDay()) % 7) || 7) + 7;",
          "  const monday = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate() + diff));",
          "  const at = (h) => new Date(monday.getTime() + h * 3600 * 1000).toISOString();",
          "  pm.collectionVariables.set('slot_start', at(6));",
          "  pm.collectionVariables.set('slot_end', at(7));",
          "  pm.collectionVariables.set('slot2_start', at(7));",
          "  pm.collectionVariables.set('slot2_end', at(8));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Login customer",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"account_email\": \"{{customer_account_email}}\",\n  \"password\": \"{{customer_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/customers/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "customers", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('customer login returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('customer_access_token', pm.response.json().access_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. AC-1 Veterinary at Southwoods -> 422 distinct error",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          {
            "key": "Authorization",
            "value": "Bearer {{customer_access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pet_id\": \"{{pet_id}}\",\n  \"branch_id\": \"{{branch_southwoods_id}}\",\n  \"service_category\": \"Veterinary\",\n  \"service_id\": \"{{vet_service_id}}\",\n  \"scheduled_start\": \"{{slot_start}}\",\n  \"scheduled_end\": \"{{slot_end}}\",\n  \"special_instructions\": \"issue53-postman\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/bookings",
          "host": ["{{base_url}}"],
          "path": ["bookings"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('422 branch-eligibility error - not 500, not capacity (AC-1)', function () {",
              "  pm.response.to.have.status(422);",
              "  const error = pm.response.json().error;",
              "  pm.expect(error).to.include('Makati');",
              "  pm.expect(error.toLowerCase()).to.not.include('capacity');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3. AC-2 Daycare at Southwoods -> 201 (guard scoped to Veterinary)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          {
            "key": "Authorization",
            "value": "Bearer {{customer_access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pet_id\": \"{{pet_id}}\",\n  \"branch_id\": \"{{branch_southwoods_id}}\",\n  \"service_category\": \"Daycare\",\n  \"service_id\": \"{{daycare_service_id}}\",\n  \"scheduled_start\": \"{{slot_start}}\",\n  \"scheduled_end\": \"{{slot_end}}\",\n  \"payment_method\": \"Cash\",\n  \"payment_confirmed\": true,\n  \"special_instructions\": \"issue53-postman\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/bookings",
          "host": ["{{base_url}}"],
          "path": ["bookings"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 - non-Veterinary categories are unaffected at Southwoods (AC-2)', function () {",
              "  pm.response.to.have.status(201);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. AC-3 Veterinary at Makati -> 201 Confirmed",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          {
            "key": "Authorization",
            "value": "Bearer {{customer_access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pet_id\": \"{{pet_id}}\",\n  \"branch_id\": \"{{branch_makati_id}}\",\n  \"service_category\": \"Veterinary\",\n  \"service_id\": \"{{vet_service_id}}\",\n  \"scheduled_start\": \"{{slot_start}}\",\n  \"scheduled_end\": \"{{slot_end}}\",\n  \"special_instructions\": \"issue53-postman\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/bookings",
          "host": ["{{base_url}}"],
          "path": ["bookings"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Confirmed - the guard leaves Makati untouched (AC-3)', function () {",
              "  pm.response.to.have.status(201);",
              "  pm.expect(pm.response.json().booking.status).to.eql('Confirmed');",
              "});",
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('vet_booking_id', pm.response.json().booking.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "5. AC-4 Reschedule the Makati Vet booking to Southwoods -> 422",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          {
            "key": "Authorization",
            "value": "Bearer {{customer_access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"scheduled_start\": \"{{slot2_start}}\",\n  \"scheduled_end\": \"{{slot2_end}}\",\n  \"branch_id\": \"{{branch_southwoods_id}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/bookings/{{vet_booking_id}}/reschedule",
          "host": ["{{base_url}}"],
          "path": ["bookings", "{{vet_booking_id}}", "reschedule"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('422 - the same guard rejects the branch change on reschedule (AC-4)', function () {",
              "  pm.response.to.have.status(422);",
              "  pm.expect(pm.response.json().error).to.include('Makati');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
