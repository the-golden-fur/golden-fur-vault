      ]
    },
    {
      "name": "4. Login as Receptionist",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{receptionist_identifier}}\",\n  \"password\": \"{{receptionist_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/staff/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "staff", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login returns 200', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) { pm.collectionVariables.set('receptionist_access_token', pm.response.json().access_token); }"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Groomer: GET /hotel/stays (was 403, now allowed)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{groomer_access_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/hotel/stays",
          "host": ["{{base_url}}"],
          "path": ["hotel", "stays"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('not 403', function () { pm.expect(pm.response.code).to.not.equal(403); });",
              "pm.test('200 OK', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Groomer: POST /hotel/check-in (role gate only - 400/other is fine, 403 is not)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{groomer_access_token}}"
          },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"booking_id\": \"{{hotel_booking_id}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/hotel/check-in",
          "host": ["{{base_url}}"],
          "path": ["hotel", "check-in"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('role gate passed (not 403)', function () { pm.expect(pm.response.code).to.not.equal(403); });"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Groomer: GET /daycare/sessions (was 403, now allowed)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{groomer_access_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/daycare/sessions",
          "host": ["{{base_url}}"],
          "path": ["daycare", "sessions"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('not 403', function () { pm.expect(pm.response.code).to.not.equal(403); });",
              "pm.test('200 OK', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Groomer: POST /daycare/check-in (role gate only)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{groomer_access_token}}"
          },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"booking_id\": \"{{daycare_booking_id}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/daycare/check-in",
          "host": ["{{base_url}}"],
          "path": ["daycare", "check-in"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('role gate passed (not 403)', function () { pm.expect(pm.response.code).to.not.equal(403); });"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Cashier: Advance payment with NO choice on Unpaid booking (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{cashier_access_token}}"
          },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": {
          "raw": "{{base_url}}/bookings/{{payment_stage_booking_id}}/payment-stage/advance",
          "host": ["{{base_url}}"],
          "path": [
            "bookings",
            "{{payment_stage_booking_id}}",
            "payment-stage",
            "advance"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 - choice required', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Cashier: Advance payment choice=advance (200, Paid in Advance)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{cashier_access_token}}"
          },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"choice\": \"advance\"\n}" },
        "url": {
          "raw": "{{base_url}}/bookings/{{payment_stage_booking_id}}/payment-stage/advance",
          "host": ["{{base_url}}"],
          "path": [
            "bookings",
            "{{payment_stage_booking_id}}",
            "payment-stage",
            "advance"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('payment_stage is Paid in Advance', function () { pm.expect(pm.response.json().booking.payment_stage).to.eql('Paid in Advance'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Cashier: Advance payment again, no choice needed (200, Paid)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{cashier_access_token}}"
          },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": {
          "raw": "{{base_url}}/bookings/{{payment_stage_booking_id}}/payment-stage/advance",
          "host": ["{{base_url}}"],
          "path": [
            "bookings",
            "{{payment_stage_booking_id}}",
            "payment-stage",
            "advance"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('payment_stage is Paid', function () { pm.expect(pm.response.json().booking.payment_stage).to.eql('Paid'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Cashier: Advance payment on already-Paid booking (409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{cashier_access_token}}"
          },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": {
          "raw": "{{base_url}}/bookings/{{payment_stage_booking_id}}/payment-stage/advance",
          "host": ["{{base_url}}"],
          "path": [
            "bookings",
            "{{payment_stage_booking_id}}",
            "payment-stage",
            "advance"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 - already paid', function () { pm.response.to.have.status(409); });"
            ]
          }
        }
      ]
    },
    {
      "name": "13. Groomer: Override payment stage (403 - not an override role)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{groomer_access_token}}"
          },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"payment_stage\": \"Unpaid\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/bookings/{{payment_stage_booking_id}}/payment-stage",
          "host": ["{{base_url}}"],
          "path": ["bookings", "{{payment_stage_booking_id}}", "payment-stage"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('403 Forbidden', function () { pm.response.to.have.status(403); });"
            ]
          }
        }
      ]
    },
    {
      "name": "14. Admin: Override payment stage back to Unpaid (200)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{admin_access_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"payment_stage\": \"Unpaid\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/bookings/{{payment_stage_booking_id}}/payment-stage",
          "host": ["{{base_url}}"],
          "path": ["bookings", "{{payment_stage_booking_id}}", "payment-stage"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('payment_stage reverted to Unpaid', function () { pm.expect(pm.response.json().booking.payment_stage).to.eql('Unpaid'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "15. Groomer: List bookings assigned to me",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{groomer_access_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/bookings?assigned_staff_id={{groomer_staff_id}}",
          "host": ["{{base_url}}"],
          "path": ["bookings"],
          "query": [
            { "key": "assigned_staff_id", "value": "{{groomer_staff_id}}" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('every booking is assigned to this staff id', function () {",
              "  const bookings = pm.response.json().bookings;",
              "  bookings.forEach((b) => pm.expect(b.assigned_staff_id).to.eql(pm.collectionVariables.get('groomer_staff_id')));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "16. Receptionist: List unassigned bookings",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{receptionist_access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/bookings?assigned_staff_id=unassigned",
          "host": ["{{base_url}}"],
          "path": ["bookings"],
          "query": [{ "key": "assigned_staff_id", "value": "unassigned" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('every booking has no assigned staff', function () {",
              "  const bookings = pm.response.json().bookings;",
              "  bookings.forEach((b) => pm.expect(b.assigned_staff_id).to.be.null);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "17. Round 2: retired POST /bookings/:id/mark-paid no longer exists (404)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{cashier_access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/bookings/{{payment_stage_booking_id}}/mark-paid",
          "host": ["{{base_url}}"],
          "path": ["bookings", "{{payment_stage_booking_id}}", "mark-paid"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 - route removed (payment_stage/advance replaces it)', function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    },
    {
      "name": "18. Round 2: booking.status never reaches Paid - list bookings and confirm",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{receptionist_access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/bookings",
          "host": ["{{base_url}}"],
          "path": ["bookings"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('no booking has status Paid', function () {",
              "  const bookings = pm.response.json().bookings;",
              "  bookings.forEach((b) => pm.expect(b.status).to.not.eql('Paid'));",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
