              "  pm.collectionVariables.set('customer_access_token', pm.response.json().access_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "15. Customer toggles their own booking_cancelled email preference off",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          {
            "key": "Authorization",
            "value": "Bearer {{customer_access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_type\": \"booking_cancelled\",\n  \"channel\": \"email\",\n  \"enabled\": false\n}"
        },
        "url": {
