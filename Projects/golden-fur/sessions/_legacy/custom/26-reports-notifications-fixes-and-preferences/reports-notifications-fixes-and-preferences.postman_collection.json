              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().notification_preferences.password_reset.in_browser).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "14. Login as customer",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{customer_identifier}}\",\n  \"password\": \"{{customer_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/customers/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "customers", "login"]
