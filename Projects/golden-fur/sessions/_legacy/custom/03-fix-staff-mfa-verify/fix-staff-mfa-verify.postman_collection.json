{
  "info": {
    "name": "Fix Staff MFA Verify - Admin Client Session Pollution Regression",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "account_a_identifier", "value": "" },
    { "key": "account_a_password", "value": "" },
    { "key": "account_a_access_token", "value": "" },
    { "key": "account_a_totp_code", "value": "" },
    { "key": "account_b_identifier", "value": "" },
    { "key": "account_b_password", "value": "" },
    { "key": "account_b_access_token", "value": "" },
    { "key": "account_b_totp_code", "value": "" }
  ],
  "item": [
    {
      "name": "1. Account A - Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{account_a_identifier}}\",\n  \"password\": \"{{account_a_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/staff/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "staff", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login succeeds', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('account_a_access_token', pm.response.json().access_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Account A - MFA Enroll",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{account_a_access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/staff/mfa/enroll",
          "host": ["{{base_url}}"],
          "path": ["auth", "staff", "mfa", "enroll"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200 with a totp secret/uri', () => {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.totp && (body.totp.qr_code || body.totp.uri || body.totp.secret)).to.be.ok;",
              "});",
              "console.log('Scan/enter body.totp.secret in an authenticator app, then set account_a_totp_code to the current 6-digit code before running the next request.');"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Account A - MFA Verify (this is the request that used to 500)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          {
            "key": "Authorization",
            "value": "Bearer {{account_a_access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"{{account_a_totp_code}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/staff/mfa/verify",
          "host": ["{{base_url}}"],
          "path": ["auth", "staff", "mfa", "verify"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200, not 500', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('account_a_access_token', pm.response.json().access_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Account B - Login (do NOT restart the server between this and step 1)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{account_b_identifier}}\",\n  \"password\": \"{{account_b_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/staff/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "staff", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login succeeds', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('account_b_access_token', pm.response.json().access_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Account B - MFA Enroll",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{account_b_access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/staff/mfa/enroll",
          "host": ["{{base_url}}"],
          "path": ["auth", "staff", "mfa", "enroll"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200 with a totp secret/uri', () => {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.totp && (body.totp.qr_code || body.totp.uri || body.totp.secret)).to.be.ok;",
              "});",
              "console.log('Scan/enter body.totp.secret in an authenticator app, then set account_b_totp_code to the current 6-digit code before running the next request.');"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Account B - MFA Verify (regression check: fails here before the fix even though B never touched A's session directly)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          {
            "key": "Authorization",
            "value": "Bearer {{account_b_access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"{{account_b_totp_code}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/staff/mfa/verify",
          "host": ["{{base_url}}"],
          "path": ["auth", "staff", "mfa", "verify"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200, not 500', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('account_b_access_token', pm.response.json().access_token);",
              "}"
            ]
          }
        }
      ]
    }
  ]
}
