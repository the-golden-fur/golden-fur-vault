            ]
          }
        }
      ]
    },
    {
      "name": "Staff Lower-Priv - MFA Status (before enroll, optional role)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{lower_priv_access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/staff/mfa/status",
          "host": ["{{base_url}}"],
          "path": ["auth", "staff", "mfa", "status"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
