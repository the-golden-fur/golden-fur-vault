    {
      "name": "Regression - Fresh Admin Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{fresh_identifier}}\",\n  \"password\": \"{{fresh_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/staff/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "staff", "login"]
        },
        "description": "Use a staff account (Admin or Superadmin) that has never enrolled MFA to reproduce the original bug report on purpose."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login succeeds', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  if (body.access_token) pm.collectionVariables.set('fresh_access_token', body.access_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Regression - Verify Without Enrolling First (expected 400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{fresh_access_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"000000\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/staff/mfa/verify",
          "host": ["{{base_url}}"],
          "path": ["auth", "staff", "mfa", "verify"]
        },
        "description": "This is the exact call that used to be reported as 'MFA verify fails with TOTP factor not found'. It is EXPECTED to 400 here, on purpose, because Verify was called before Enroll for this account - that is what the mandatory setup popup (Admin/Superadmin) and the Settings enrollment flow (everyone else) now exist to prevent. If you ever see this same error on an account that HAS completed Enroll+Verify, that is the real bug - check fix-mfa.sql for orphaned unverified factors first, and use the Unenroll requests above as a self-service recovery if one is found."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 No TOTP factor found (expected - never enrolled)', () => {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json().error).to.eql('No TOTP factor found');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
