          "raw": "{\n  \"code\": \"{{totp_code}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/staff/mfa/verify",
          "host": ["{{base_url}}"],
          "path": ["auth", "staff", "mfa", "verify"]
        },
        "description": "Set totp_code from the Enroll request immediately above before running this."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  if (body.access_token) pm.collectionVariables.set('lower_priv_access_token', body.access_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Staff Lower-Priv - MFA Unenroll (Disable MFA)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{lower_priv_access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/staff/mfa/unenroll",
          "host": ["{{base_url}}"],
          "path": ["auth", "staff", "mfa", "unenroll"]
        },
        "description": "Mirrors the Settings page 'Disable MFA' button. Requires the caller's session to be aal2 already - it is here, because MFA Verify immediately above refreshed the session to aal2 on success. Removes every TOTP factor for the caller."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200 with the removed factor id(s)', () => {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.removed.length).to.be.greaterThan(0);",
              "  pm.expect(body.failed).to.eql([]);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Staff Lower-Priv - MFA Status (after unenroll)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{lower_priv_access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/staff/mfa/status",
          "host": ["{{base_url}}"],
          "path": ["auth", "staff", "mfa", "status"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('mfa_enrolled is false again after unenroll', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().mfa_enrolled).to.eql(false);",
              "});"
            ]
          }
        }
      ]
    },
