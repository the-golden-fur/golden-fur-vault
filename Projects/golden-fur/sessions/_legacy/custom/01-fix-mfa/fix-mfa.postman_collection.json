      ]
    },
    {
      "name": "Staff Lower-Priv - MFA Enroll (Settings flow)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{lower_priv_access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/staff/mfa/enroll",
          "host": ["{{base_url}}"],
          "path": ["auth", "staff", "mfa", "enroll"]
        },
        "description": "Mirrors what the client's Settings page MFA section calls for a lower-privilege staff role choosing to opt in."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Staff Lower-Priv - MFA Verify",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{lower_priv_access_token}}"
