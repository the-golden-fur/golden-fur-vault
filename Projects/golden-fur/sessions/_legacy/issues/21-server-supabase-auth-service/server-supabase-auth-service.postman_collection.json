{
  "info": {
    "name": "Issue 21 - Server Supabase Auth Service Refactor",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "staff_identifier",
      "value": ""
    },
    {
      "key": "staff_email",
      "value": ""
    },
    {
      "key": "staff_password",
      "value": ""
    },
    {
      "key": "staff_access_token",
      "value": ""
    },
    {
      "key": "staff_totp_code",
      "value": ""
    },
    {
      "key": "customer_full_name",
      "value": "Postman Test Customer"
    },
    {
      "key": "customer_signup_email",
      "value": ""
    },
    {
      "key": "customer_password",
      "value": ""
    },
    {
      "key": "customer_email",
      "value": ""
    },
    {
      "key": "customer_access_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Staff - Login with username identifier",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{staff_identifier}}\",\n  \"password\": \"{{staff_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/staff/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "staff", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('username login still returns 200 after resolveStaffLoginIdentifier refactor', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test('response includes access_token and refresh_token', function () {",
              "    pm.expect(body.access_token).to.be.a('string');",
              "    pm.expect(body.refresh_token).to.be.a('string');",
              "  });",
              "  pm.collectionVariables.set('staff_access_token', body.access_token || '');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Staff - Login with email identifier",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{staff_email}}\",\n  \"password\": \"{{staff_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/staff/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "staff", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('email login still returns 200 (resolveStaffLoginIdentifier short-circuits on @)', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.collectionVariables.set('staff_access_token', body.access_token || '');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Staff - Login with bad username fails with generic 401",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"this-username-does-not-exist\",\n  \"password\": \"{{staff_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/staff/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "staff", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('resolveStaffLoginIdentifier failure still surfaces as generic 401 (AC-6)', function () {",
              "  pm.response.to.have.status(401);",
              "  pm.expect(pm.response.json().error).to.eql('Unauthorized');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Staff - MFA Enroll (JWT + userClient path untouched by refactor)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{staff_access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "{{base_url}}/auth/staff/mfa/enroll",
          "host": ["{{base_url}}"],
          "path": ["auth", "staff", "mfa", "enroll"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('MFA enroll route still reachable through jwtMiddleware', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Staff - MFA Verify (TOTP path untouched by refactor)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{staff_access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"{{staff_totp_code}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/staff/mfa/verify",
          "host": ["{{base_url}}"],
          "path": ["auth", "staff", "mfa", "verify"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('AC-4: TOTP verify still functions (200 on valid code, 401 on invalid, 423 if locked out)', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 401, 423]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Customer - Signup (createCustomerAuthUser + createCustomerProfile)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"{{customer_full_name}}\",\n  \"account_email\": \"{{customer_signup_email}}\",\n  \"password\": \"{{customer_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/customers/signup",
          "host": ["{{base_url}}"],
          "path": ["auth", "customers", "signup"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('signup still returns 201 after moving admin.createUser + profile insert into supabaseAuth.api.ts', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "if (pm.response.code === 201) {",
              "  pm.test('response includes the created user', function () {",
              "    pm.expect(pm.response.json().user).to.exist;",
              "  });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Customer - Login (unchanged sign-in path)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"account_email\": \"{{customer_email}}\",\n  \"password\": \"{{customer_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/customers/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "customers", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('customer login returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.collectionVariables.set('customer_access_token', body.access_token || '');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
