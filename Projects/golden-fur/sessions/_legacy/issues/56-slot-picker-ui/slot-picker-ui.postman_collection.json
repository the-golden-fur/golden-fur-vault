{
  "info": {
    "name": "Issue 56 - Slot Picker UI (GET /bookings/availability)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "customer_account_email", "value": "" },
    { "key": "customer_password", "value": "" },
    { "key": "customer_access_token", "value": "" },
    { "key": "branch_makati_id", "value": "" },
    {
      "key": "invalid_branch_id",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    { "key": "future_date", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('future_date')) {",
          "  const day = 24 * 3600 * 1000;",
          "  const d = new Date(Date.now() + 7 * day);",
          "  pm.collectionVariables.set('future_date', d.toISOString().slice(0, 10));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Login customer",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"account_email\": \"{{customer_account_email}}\",\n  \"password\": \"{{customer_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/customers/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "customers", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('customer login returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('customer_access_token', pm.response.json().access_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. AC-1/AC-4 Grooming availability, one week out",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customer_access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/bookings/availability?branch_id={{branch_makati_id}}&service_category=Grooming&date={{future_date}}&slot_duration_minutes=60",
          "host": ["{{base_url}}"],
          "path": ["bookings", "availability"],
          "query": [
            { "key": "branch_id", "value": "{{branch_makati_id}}" },
            { "key": "service_category", "value": "Grooming" },
            { "key": "date", "value": "{{future_date}}" },
            { "key": "slot_duration_minutes", "value": "60" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 with a slots array shaped for the picker', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.slots).to.be.an('array');",
              "  pm.expect(body.slots.length).to.be.greaterThan(0);",
              "  const slot = body.slots[0];",
              "  pm.expect(slot).to.have.all.keys('start', 'end', 'available', 'level', 'eligible_staff_count');",
              "  pm.expect(['available', 'partial', 'full']).to.include(slot.level);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Hotel availability (level derives from cage capacity, not staff)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customer_access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/bookings/availability?branch_id={{branch_makati_id}}&service_category=Hotel&date={{future_date}}&slot_duration_minutes=1440&pet_weight_class=M",
          "host": ["{{base_url}}"],
          "path": ["bookings", "availability"],
          "query": [
            { "key": "branch_id", "value": "{{branch_makati_id}}" },
            { "key": "service_category", "value": "Hotel" },
            { "key": "date", "value": "{{future_date}}" },
            { "key": "slot_duration_minutes", "value": "1440" },
            { "key": "pet_weight_class", "value": "M" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200, Hotel slots omit eligible_staff_count', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.slots).to.be.an('array');",
              "  if (body.slots.length > 0) {",
              "    pm.expect(body.slots[0]).to.not.have.property('eligible_staff_count');",
              "  }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Hotel availability missing pet_weight_class -> 400",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customer_access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/bookings/availability?branch_id={{branch_makati_id}}&service_category=Hotel&date={{future_date}}&slot_duration_minutes=60",
          "host": ["{{base_url}}"],
          "path": ["bookings", "availability"],
          "query": [
            { "key": "branch_id", "value": "{{branch_makati_id}}" },
            { "key": "service_category", "value": "Hotel" },
            { "key": "date", "value": "{{future_date}}" },
            { "key": "slot_duration_minutes", "value": "60" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 - pet_weight_class required for Hotel', function () {",
              "  pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Unknown branch_id -> 404",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customer_access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/bookings/availability?branch_id={{invalid_branch_id}}&service_category=Grooming&date={{future_date}}&slot_duration_minutes=60",
          "host": ["{{base_url}}"],
          "path": ["bookings", "availability"],
          "query": [
            { "key": "branch_id", "value": "{{invalid_branch_id}}" },
            { "key": "service_category", "value": "Grooming" },
            { "key": "date", "value": "{{future_date}}" },
            { "key": "slot_duration_minutes", "value": "60" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 - branch not found', function () {",
              "  pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
