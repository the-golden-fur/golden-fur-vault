{
  "info": {
    "name": "Issue 24 - Staff Unavailability Block Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "staff_identifier", "value": "" },
    { "key": "staff_password", "value": "" },
    { "key": "staff_id", "value": "" },
    { "key": "staff_access_token", "value": "" },
    { "key": "peer_staff_id", "value": "" },
    { "key": "admin_identifier", "value": "" },
    { "key": "admin_password", "value": "" },
    { "key": "admin_access_token", "value": "" },
    { "key": "block_id", "value": "" },
    { "key": "quick_block_id", "value": "" },
    { "key": "peer_block_id", "value": "" }
  ],
  "item": [
    {
      "name": "1. Login as self (regular staff)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{staff_identifier}}\",\n  \"password\": \"{{staff_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/staff/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "staff", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login returns 200 with an access token', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().access_token).to.be.a('string');",
              "});",
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('staff_access_token', pm.response.json().access_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. AC-2: POST custom start/end range creates a block",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{staff_access_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start_time\": \"2027-01-01T01:00:00.000Z\",\n  \"end_time\": \"2027-01-01T03:00:00.000Z\",\n  \"reason\": \"Postman verification\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/staff/{{staff_id}}/unavailability",
          "host": ["{{base_url}}"],
          "path": ["staff", "{{staff_id}}", "unavailability"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('AC-2: returns 201 for the exact requested range', function () {",
              "  pm.response.to.have.status(201);",
              "  const block = pm.response.json().block;",
              "  pm.expect(block.start_time).to.eql('2027-01-01T01:00:00.000Z');",
              "  pm.expect(block.end_time).to.eql('2027-01-01T03:00:00.000Z');",
              "});",
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('block_id', pm.response.json().block.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "3. AC-3: POST an overlapping range is rejected",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{staff_access_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start_time\": \"2027-01-01T02:00:00.000Z\",\n  \"end_time\": \"2027-01-01T04:00:00.000Z\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/staff/{{staff_id}}/unavailability",
          "host": ["{{base_url}}"],
          "path": ["staff", "{{staff_id}}", "unavailability"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('AC-3: overlapping block returns 409', function () {",
              "  pm.response.to.have.status(409);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. AC-5: GET active and upcoming blocks",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{staff_access_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/staff/{{staff_id}}/unavailability",
          "host": ["{{base_url}}"],
          "path": ["staff", "{{staff_id}}", "unavailability"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('AC-5: returns 200 and includes the created block', function () {",
              "  pm.response.to.have.status(200);",
              "  const blocks = pm.response.json().blocks;",
              "  const ids = blocks.map((b) => b.id);",
              "  pm.expect(ids).to.include(pm.collectionVariables.get('block_id'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. AC-4: DELETE own block cancels it",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{staff_access_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/staff/{{staff_id}}/unavailability/{{block_id}}",
          "host": ["{{base_url}}"],
          "path": ["staff", "{{staff_id}}", "unavailability", "{{block_id}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('AC-4: cancelling own block returns 204', function () {",
              "  pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. AC-1: POST quick-action block ends at branch closing time",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{staff_access_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quick_action\": true,\n  \"reason\": \"Rest of shift\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/staff/{{staff_id}}/unavailability",
          "host": ["{{base_url}}"],
          "path": ["staff", "{{staff_id}}", "unavailability"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('AC-1: quick action returns 201 with a resolved end_time, or 400 if the branch is closed today', function () {",
              "  pm.expect([201, 400]).to.include(pm.response.code);",
              "  if (pm.response.code === 201) {",
              "    const block = pm.response.json().block;",
              "    pm.expect(block.end_time).to.be.a('string');",
              "    pm.collectionVariables.set('quick_block_id', block.id);",
              "  }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Cleanup: DELETE quick-action block",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{staff_access_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/staff/{{staff_id}}/unavailability/{{quick_block_id}}",
          "host": ["{{base_url}}"],
          "path": [
            "staff",
            "{{staff_id}}",
            "unavailability",
            "{{quick_block_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('cleanup: returns 204, or 404 if request 6 hit the branch-closed-today case', function () {",
              "  pm.expect([204, 404]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Login as Admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{admin_identifier}}\",\n  \"password\": \"{{admin_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/staff/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "staff", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('admin login returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('admin_access_token', pm.response.json().access_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Dev notes: Admin creates a block on behalf of peer staff",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{admin_access_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start_time\": \"2027-02-01T01:00:00.000Z\",\n  \"end_time\": \"2027-02-01T03:00:00.000Z\",\n  \"reason\": \"Created by admin on behalf of peer\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/staff/{{peer_staff_id}}/unavailability",
          "host": ["{{base_url}}"],
          "path": ["staff", "{{peer_staff_id}}", "unavailability"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin can create a block for another staff member', function () {",
              "  pm.response.to.have.status(201);",
              "  const block = pm.response.json().block;",
              "  pm.expect(block.staff_id).to.eql(pm.collectionVariables.get('peer_staff_id'));",
              "  pm.collectionVariables.set('peer_block_id', block.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "10. AC-4: self staff cannot cancel peer's block",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{staff_access_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/staff/{{peer_staff_id}}/unavailability/{{peer_block_id}}",
          "host": ["{{base_url}}"],
          "path": [
            "staff",
            "{{peer_staff_id}}",
            "unavailability",
            "{{peer_block_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('AC-4: non-admin cancelling another staff member\\'s block returns 403', function () {",
              "  pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "11. AC-4: Admin cancels peer's block (cleanup)",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{admin_access_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/staff/{{peer_staff_id}}/unavailability/{{peer_block_id}}",
          "host": ["{{base_url}}"],
          "path": [
            "staff",
            "{{peer_staff_id}}",
            "unavailability",
            "{{peer_block_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('AC-4: Admin cancelling another staff member\\'s block returns 204', function () {",
              "  pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
