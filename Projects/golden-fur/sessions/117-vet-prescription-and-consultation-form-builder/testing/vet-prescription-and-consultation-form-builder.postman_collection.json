          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Ongoing, medicine_type/frequency/duration saved on the medication', () => {",
              "  pm.response.to.have.status(200);",
              "  const consultation = pm.response.json().consultation;",
              "  pm.expect(consultation.status).to.eql('Ongoing');",
