    {
      "name": "21. PATCH consultation -> Completed: amount added, plus form_responses (vitals/diagnosis now live here, not as their own columns)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{vet_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Completed\",\n  \"professional_fee\": 500,\n  \"medications\": [\n    {\n      \"name\": \"Amoxicillin\",\n      \"dose\": \"250mg\",\n      \"medicine_type\": \"Oral\",\n      \"frequency\": \"Twice daily\",\n      \"duration\": \"7 days\",\n      \"amount\": 150\n    }\n  ],\n  \"form_responses\": [\n    {\n      \"template_id\": \"{{default_template_id}}\",\n      \"template_name\": \"General Consultation\",\n      \"filled_at\": \"2026-09-29T00:00:00.000Z\",\n      \"fields\": [\n        { \"field_id\": \"temperature\", \"label\": \"Temperature\", \"type\": \"number\", \"value\": 38.5 },\n        { \"field_id\": \"weight\", \"label\": \"Weight (kg)\", \"type\": \"number\", \"value\": 12.4 },\n        { \"field_id\": \"diagnosis\", \"label\": \"Diagnosis\", \"type\": \"textarea\", \"value\": \"Dental tartar buildup\" }\n      ]\n    },\n    {\n      \"template_id\": \"{{template_id}}\",\n      \"template_name\": \"Dental Check\",\n      \"filled_at\": \"2026-09-29T00:00:00.000Z\",\n      \"fields\": [\n        { \"field_id\": \"tartar\", \"label\": \"Tartar level\", \"type\": \"text\", \"value\": \"Moderate\" },\n        { \"field_id\": \"condition\", \"label\": \"Overall condition\", \"type\": \"select\", \"value\": \"Fair\" }\n      ]\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{base_url}}/veterinary/consultations/{{consultation_id}}",
          "host": ["{{base_url}}"],
          "path": ["veterinary", "consultations", "{{consultation_id}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Completed, no procedure line item, both form_responses entries persisted verbatim', () => {",
              "  pm.response.to.have.status(200);",
              "  const consultation = pm.response.json().consultation;",
              "  pm.expect(consultation.status).to.eql('Completed');",
              "  pm.expect(consultation.form_responses).to.have.lengthOf(2);",
              "  const general = consultation.form_responses.find((r) => r.template_name === 'General Consultation');",
              "  const dental = consultation.form_responses.find((r) => r.template_name === 'Dental Check');",
              "  pm.expect(general.fields.find((f) => f.field_id === 'diagnosis').value).to.eql('Dental tartar buildup');",
              "  pm.expect(dental.fields.find((f) => f.field_id === 'condition').value).to.eql('Fair');",
              "});",
              "pm.test('Reminder: verify in Supabase Studio - consultation_line_items for this consultation_id has exactly 2 rows (professional_fee + medication), no procedure row; and consultations.temperature/weight/diagnosis stayed NULL, since the client never sends them any more', () => {",
              "  pm.expect(true).to.be.true;",
              "});"
            ]
          }
        }
      ]
