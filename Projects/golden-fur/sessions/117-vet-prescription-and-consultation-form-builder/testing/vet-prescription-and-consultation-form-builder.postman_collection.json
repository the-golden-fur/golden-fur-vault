        },
        "url": {
          "raw": "{{base_url}}/veterinary/medication-catalog",
          "host": ["{{base_url}}"],
          "path": ["veterinary", "medication-catalog"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('medication created, no dose/frequency fields on the response (columns dropped by 20260929233)', () => {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.medication.name).to.eql('Amoxicillin');",
              "  pm.expect(body.medication.default_medicine_type).to.eql('Oral');",
              "  pm.expect(body.medication).to.not.have.property('default_dose');",
              "  pm.expect(body.medication).to.not.have.property('default_frequency');",
              "  pm.collectionVariables.set('medication_catalog_id', body.medication.id);",
              "});"
            ]
          }
        }
      ]
