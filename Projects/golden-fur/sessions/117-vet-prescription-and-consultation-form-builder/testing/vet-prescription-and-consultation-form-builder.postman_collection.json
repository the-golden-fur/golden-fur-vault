          "raw": "{\n  \"status\": \"Ongoing\",\n  \"medications\": [\n    {\n      \"name\": \"Amoxicillin\",\n      \"dose\": \"250mg\",\n      \"medicine_type\": \"Oral\",\n      \"frequency\": \"Twice daily\",\n      \"duration\": \"7 days\"\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{base_url}}/veterinary/consultations/{{consultation_id}}",
          "host": ["{{base_url}}"],
          "path": ["veterinary", "consultations", "{{consultation_id}}"]
        }
