          "raw": "{\n  \"name\": \"Standard Post-Surgery Recovery\",\n  \"items\": [\n    {\n      \"medication_catalog_id\": \"{{medication_catalog_id}}\",\n      \"name\": \"Amoxicillin\",\n      \"medicine_type\": \"Oral\",\n      \"dose\": \"250mg\",\n      \"frequency\": \"Twice daily\",\n      \"duration\": \"7 days\"\n    }\n  ]\n}"
